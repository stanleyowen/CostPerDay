        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши вещи обходятся вам в"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các món đồ của bạn tiêu tốn"
