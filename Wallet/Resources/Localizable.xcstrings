    "Amount, type, account, category, note, merchant, date and labels. Leave the category out and Wallet picks the one you usually use.": {
      "comment": "Shortcuts & Siri help screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrag, Art, Konto, Kategorie, Notiz, Händler, Datum und Labels. Wenn Sie keine Kategorie angeben, wählt Wallet die von Ihnen üblicherweise verwendete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount, type, account, category, note, merchant, date and labels. Leave the category out and Wallet picks the one you usually use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe, tipo, cuenta, categoría, nota, comercio, fecha y etiquetas. Si omite la categoría, Wallet elige la que usted suele utilizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montant, type, compte, catégorie, note, marchand, date et étiquettes. Si vous omettez la catégorie, Wallet choisit celle que vous utilisez habituellement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah, jenis, akun, kategori, catatan, merchant, tanggal, dan label. Jika kategori dikosongkan, Wallet memilih kategori yang biasa Anda gunakan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額、種類、口座、カテゴリ、メモ、加盟店、日付、ラベルを指定できます。カテゴリを省略すると、Wallet が普段お使いのカテゴリを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액, 유형, 계좌, 카테고리, 메모, 가맹점, 날짜 및 라벨을 지정할 수 있습니다. 카테고리를 비워 두면 Wallet가 평소에 사용하는 카테고리를 선택합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor, tipo, conta, categoria, nota, comerciante, data e etiquetas. Se você omitir a categoria, o Wallet escolherá a que você costuma usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма, тип, счёт, категория, заметка, продавец, дата и метки. Если категория не указана, Wallet выберет ту, которую вы обычно используете."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền, loại, tài khoản, danh mục, ghi chú, người bán, ngày và nhãn. Nếu bạn bỏ trống danh mục, Wallet sẽ chọn danh mục bạn thường dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额、类型、账户、类别、备注、商户、日期和标签。若未指定类别，Wallet 会自动选择您常用的类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金額、類型、帳戶、類別、備註、商戶、日期與標籤。若未指定類別，Wallet 會自動選擇您慣用的類別。"
          }
        }
      }
    },
