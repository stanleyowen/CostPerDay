    "Bring your history over from BudgetBakers Wallet, or start fresh with your first account.": {
      "comment": "Home screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernehmen Sie Ihren Verlauf aus BudgetBakers Wallet oder beginnen Sie neu mit Ihrem ersten Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your history over from BudgetBakers Wallet, or start fresh with your first account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traiga su historial desde BudgetBakers Wallet o empiece de cero con su primera cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez votre historique depuis BudgetBakers Wallet ou repartez de zéro avec votre premier compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan riwayat Anda dari BudgetBakers Wallet, atau mulai dari awal dengan akun pertama Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers Wallet から履歴を移行するか、最初の口座を作成して新たに始めましょう。"
