    "Labels cut across categories — a shop, a trip, a person you split costs with.": {
      "comment": "Category and label pickers",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels gelten kategorienübergreifend – etwa für ein Geschäft, eine Reise oder eine Person, mit der Sie Kosten teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels cut across categories — a shop, a trip, a person you split costs with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas abarcan varias categorías: una tienda, un viaje, una persona con quien comparte gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étiquettes regroupent des éléments de plusieurs catégories : un magasin, un voyage, une personne avec qui vous partagez des frais."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label berlaku lintas kategori — misalnya toko, perjalanan, atau orang yang berbagi biaya dengan Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルはカテゴリをまたいで使用できます。たとえば店舗、旅行、費用を分担する相手などです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨은 카테고리와 별개로 지정합니다. 예를 들어 상점, 여행, 비용을 나누는 사람 등에 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As etiquetas abrangem várias categorias: uma loja, uma viagem, uma pessoa com quem você divide despesas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки действуют независимо от категорий — например, магазин, поездка или человек, с которым вы делите расходы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhãn áp dụng xuyên suốt các danh mục — chẳng hạn một cửa hàng, một chuyến đi, hoặc một người cùng chia sẻ chi phí với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签可跨越类别使用，例如一家商店、一次旅行，或与您分摊费用的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤可跨越類別使用，例如一家商店、一趟旅行，或與您分攤費用的人。"
          }
        }
      }
    },
