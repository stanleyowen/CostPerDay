        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan batas bulanan untuk semua pengeluaran, atau untuk kategori yang ingin Anda pantau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての支出、または注意しておきたいカテゴリに月ごとの上限を設定します。"
