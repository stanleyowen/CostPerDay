    "Suggested from a cached rate. Please confirm it is still accurate.": {
      "comment": "Note under a suggested exchange rate",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschlag auf Grundlage eines gespeicherten Kurses. Bitte bestätigen Sie, dass er noch zutrifft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested from a cached rate. Please confirm it is still accurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerida a partir de una tasa guardada. Confirme que sigue siendo correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggéré d'après un taux mis en cache. Veuillez confirmer qu'il est toujours exact."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disarankan berdasarkan kurs tersimpan. Mohon pastikan nilainya masih akurat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのレートに基づく推奨値です。現在も正しいかご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 환율을 바탕으로 제안된 값입니다. 값이 여전히 정확한지 확인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerida com base em uma taxa salva. Confirme se ainda está correta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложено на основе сохранённого курса. Подтвердите его актуальность."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đề xuất từ tỷ giá đã lưu. Vui lòng xác nhận rằng tỷ giá này vẫn chính xác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此为依据缓存汇率给出的建议值，请确认是否仍然准确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此為依快取匯率提供的建議值，請確認是否仍然準確。"
          }
        }
      }
    },
    "Suggested from today's rate. Adjust it if you prefer a different value.": {
      "comment": "Note under a suggested exchange rate",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschlag auf Grundlage des heutigen Kurses. Passen Sie ihn an, wenn Sie einen anderen Wert bevorzugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested from today's rate. Adjust it if you prefer a different value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerida a partir de la tasa de hoy. Modifíquela si prefiere otro valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggéré d'après le taux du jour. Modifiez-le si vous préférez une autre valeur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disarankan berdasarkan kurs hari ini. Sesuaikan bila Anda menghendaki nilai yang berbeda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日のレートに基づく推奨値です。別の値をご希望の場合は変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 환율을 바탕으로 제안된 값입니다. 다른 값을 원하시면 수정해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerida com base na taxa de hoje. Ajuste-a se preferir outro valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложено на основе сегодняшнего курса. Измените значение, если требуется другое."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đề xuất từ tỷ giá hôm nay. Hãy điều chỉnh nếu bạn muốn một giá trị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此为依据今日汇率给出的建议值，如需其他数值请自行调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此為依今日匯率提供的建議值，如需其他數值請自行調整。"
          }
        }
      }
    },
    "Suggested from today's rate. Original amounts are kept; this only affects totals.": {
      "comment": "Import footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschlag auf Grundlage des heutigen Kurses. Die ursprünglichen Beträge bleiben erhalten; dies wirkt sich nur auf die Summen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested from today's rate. Original amounts are kept; this only affects totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerido a partir de la tasa de hoy. Los importes originales se conservan; esto solo afecta a los totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposé d'après le taux du jour. Les montants d'origine sont conservés ; seuls les totaux sont concernés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disarankan berdasarkan kurs hari ini. Jumlah asli tetap dipertahankan; ini hanya memengaruhi total."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日のレートに基づく推奨値です。元の金額は保持され、合計のみに影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 환율을 기준으로 제안된 값입니다. 원래 금액은 유지되며 합계에만 영향을 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerida com base na taxa de hoje. Os valores originais são mantidos; isso afeta apenas os totais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложено на основе сегодняшнего курса. Исходные суммы сохраняются; это влияет только на итоги."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đề xuất theo tỷ giá hôm nay. Số tiền gốc được giữ nguyên; tỷ giá này chỉ ảnh hưởng đến tổng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此为依据今日汇率给出的建议值。原始金额会保留，仅影响合计金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此為依今日匯率提供的建議值。原始金額會保留，僅影響合計金額。"
          }
        }
      }
    },
