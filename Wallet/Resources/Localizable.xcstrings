    "Leave empty for now.": {
      "comment": "Shortcuts / Siri action text",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den aktuellen Zeitpunkt zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para usar el momento actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser la date et l'heure actuelles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan untuk menggunakan waktu saat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合は現在の日時になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 현재 시각을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar o momento atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать текущее время."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để dùng thời điểm hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即为现在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即為現在。"
          }
        }
      }
    },
    "Leave empty for the total of all accounts, in your main currency.": {
      "comment": "Shortcuts / Siri action text",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um die Summe aller Konten in Ihrer Hauptwährung zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty for the total of all accounts, in your main currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para obtener el total de todas las cuentas en su moneda principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour obtenir le total de tous les comptes, dans votre devise principale."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan untuk total semua akun dalam mata uang dasar Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合は、すべての口座の合計を主要通貨で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 모든 계좌의 합계를 기준 통화로 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para obter o total de todas as contas, na sua moeda principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы получить общий итог по всем счетам в основной валюте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để lấy tổng của tất cả tài khoản, theo tiền tệ cơ sở của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即为所有账户的总额，以您的主要货币显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即為所有帳戶的總額，以您的主要貨幣顯示。"
          }
        }
      }
    },
    "Leave empty to use the account you used most recently.": {
      "comment": "Shortcuts / Siri action text",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um das zuletzt verwendete Konto zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to use the account you used most recently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para usar la cuenta que utilizó más recientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser le dernier compte utilisé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan untuk menggunakan akun yang terakhir Anda gunakan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合は、最後に使用した口座を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 가장 최근에 사용한 계좌를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar a conta utilizada mais recentemente."
          }
        },
        "ru": {
          "stringUnit": {
