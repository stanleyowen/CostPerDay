    "Add transactions from the Shortcuts app, Siri, or an automation when you pay with Apple Pay.": {
      "comment": "Settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Buchungen über die Kurzbefehle-App, mit Siri oder über eine Automation beim Bezahlen mit Apple Pay hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add transactions from the Shortcuts app, Siri, or an automation when you pay with Apple Pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada transacciones desde la app Atajos, con Siri o mediante una automatización al pagar con Apple Pay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des transactions depuis l'app Raccourcis, avec Siri ou au moyen d'une automatisation lorsque vous payez avec Apple Pay."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan transaksi dari app Pintasan, Siri, atau otomatisasi saat Anda membayar dengan Apple Pay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ショートカット」App や Siri から、または Apple Pay で支払ったときのオートメーションで取引を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 앱이나 Siri에서, 또는 Apple Pay로 결제할 때 자동화를 통해 거래를 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione transações pelo app Atalhos, pela Siri ou por uma automação ao pagar com Apple Pay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте операции из приложения «Быстрые команды», с помощью Siri или автоматизации при оплате через Apple Pay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm giao dịch từ ứng dụng Phím tắt, Siri hoặc một mục tự động hóa khi bạn thanh toán bằng Apple Pay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可通过“快捷指令”App、Siri，或在您使用 Apple Pay 付款时通过自动化添加交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可透過「捷徑」App、Siri，或在您使用 Apple Pay 付款時透過自動化新增交易。"
          }
        }
      }
    },
