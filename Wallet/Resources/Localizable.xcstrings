          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establezca un límite mensual para todo o para las categorías que desee vigilar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un plafond mensuel global ou pour les catégories que vous souhaitez surveiller."
