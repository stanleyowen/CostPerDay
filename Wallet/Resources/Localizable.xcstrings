    "Accounts, categories, labels, transfers and foreign-currency rates all come across.": {
      "comment": "Import from BudgetBakers Wallet screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten, Kategorien, Labels, Umbuchungen und Fremdwährungskurse werden vollständig übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, categories, labels, transfers and foreign-currency rates all come across."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se importan las cuentas, categorías, etiquetas, transferencias y tipos de cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes, catégories, étiquettes, virements et taux de change sont tous repris."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun, kategori, label, transfer, dan kurs mata uang asing semuanya ikut dipindahkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座、カテゴリ、ラベル、振替、外貨レートがすべて引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌, 카테고리, 라벨, 이체 및 외화 환율을 모두 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas, categorias, etiquetas, transferências e taxas de câmbio são todas importadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносятся все счета, категории, метки, переводы и курсы иностранных валют."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản, danh mục, nhãn, chuyển khoản và tỷ giá ngoại tệ đều được chuyển sang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户、类别、标签、转账和外币汇率都会一并导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶、類別、標籤、轉帳與外幣匯率都會一併匯入。"
          }
        }
      }
    },
