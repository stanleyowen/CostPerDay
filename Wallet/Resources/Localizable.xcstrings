    "Upkeep is added on top of the purchase price — repairs, accessories, servicing.": {
      "comment": "Linking transactions to tracked items",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgekosten werden zum Kaufpreis hinzugerechnet – Reparaturen, Zubehör, Wartung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upkeep is added on top of the purchase price — repairs, accessories, servicing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mantenimiento se suma al precio de compra: reparaciones, accesorios, revisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais d'entretien s'ajoutent au prix d'achat : réparations, accessoires, révisions."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya perawatan ditambahkan di atas harga pembelian — perbaikan, aksesori, servis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "維持費（修理、アクセサリー、点検など）は購入価格に上乗せされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수리, 액세서리, 정비 등의 유지비는 구입 가격에 더해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A manutenção é somada ao preço de compra: reparos, acessórios, revisões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходы на содержание прибавляются к цене покупки — ремонт, аксессуары, обслуживание."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi phí duy trì được cộng thêm vào giá mua — sửa chữa, phụ kiện, bảo dưỡng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维护费用会在购买价格之上另行计入，例如维修、配件和保养。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維護費用會加計於購買價格之上，例如維修、配件與保養。"
          }
        }
      }
    },
