        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 지출 또는 관리하려는 카테고리에 대해 월 한도를 설정하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um limite mensal para tudo ou para as categorias que deseja acompanhar de perto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите месячный лимит для всех расходов или для категорий, за которыми хотите следить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt hạn mức hằng tháng cho toàn bộ chi tiêu, hoặc cho các danh mục bạn muốn theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
