    "Follow what this purchase costs per day for as long as you keep it.": {
      "comment": "Transaction entry form",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie, was dieser Kauf pro Tag kostet, solange Sie ihn besitzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow what this purchase costs per day for as long as you keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga lo que le cuesta esta compra por día mientras la conserve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez ce que cet achat vous coûte par jour aussi longtemps que vous le conservez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau biaya per hari dari pembelian ini selama Anda memilikinya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有している間、この購入品の1日あたりのコストを追跡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구매품을 보유하는 동안 하루 비용을 계속 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe quanto esta compra custa por dia enquanto você a mantiver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте, во сколько эта покупка обходится в день, пока она у вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi chi phí mỗi ngày của món đồ này trong suốt thời gian bạn sở hữu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您持有期间，持续追踪这笔购买的每日成本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
