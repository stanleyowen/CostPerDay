    "Bought something that lasts? Track what it costs you per day.": {
      "comment": "Card subtitle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas Langlebiges gekauft? Verfolgen Sie, was es Sie pro Tag kostet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bought something that lasts? Track what it costs you per day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Compró algo duradero? Haga un seguimiento de lo que le cuesta por día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez acheté un bien durable ? Suivez ce qu'il vous coûte par jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membeli barang tahan lama? Lacak biayanya per hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長く使う物を購入しましたか？1日あたりのコストを記録しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래 쓸 물건을 구입하셨나요? 하루 비용을 관리해 보십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprou algo durável? Acompanhe quanto isso custa a você por dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Купили что-то надолго? Отслеживайте, во сколько это обходится вам в день."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa mua món đồ dùng lâu dài? Hãy theo dõi chi phí mỗi ngày của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "买了耐用的东西吗？追踪它每天的成本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "買了耐用的東西嗎？追蹤它每天的成本。"
