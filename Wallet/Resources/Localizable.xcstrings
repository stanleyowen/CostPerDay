            "value": "所有物のコストは"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보유 물품의 비용은"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus itens custam a você"
