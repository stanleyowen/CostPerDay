    "Transfers to and from other accounts are kept, marked as coming from outside Wallet. This can't be undone.": {
      "comment": "Account screens",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbuchungen von und zu anderen Konten bleiben erhalten und werden als Geldbewegungen außerhalb von Wallet gekennzeichnet. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers to and from other accounts are kept, marked as coming from outside Wallet. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias desde y hacia otras cuentas se conservan, marcadas como procedentes de fuera de Wallet. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les virements depuis et vers d'autres comptes sont conservés et marqués comme provenant de l'extérieur de Wallet. Cette action est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer ke dan dari akun lain tetap disimpan dan ditandai sebagai berasal dari luar Wallet. Tindakan ini tidak dapat diurungkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の口座との振替は保持され、Wallet 外との取引として扱われます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계좌와의 이체는 Wallet 외부와의 거래로 표시되어 유지됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências de e para outras contas são mantidas, marcadas como vindas de fora do Wallet. Essa ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы на другие счета и с них сохранятся и будут помечены как операции вне Wallet. Это действие нельзя отменить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giao dịch chuyển khoản đến và từ tài khoản khác được giữ lại và được đánh dấu là đến từ bên ngoài Wallet. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他账户之间的转账会保留，并标记为来自 Wallet 以外。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與其他帳戶之間的轉帳會保留，並標示為來自 Wallet 以外。此操作無法復原。"
          }
        }
      }
    },
