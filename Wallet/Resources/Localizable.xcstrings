    "Returns how much you've spent in a period, optionally for one category.": {
      "comment": "Shortcuts / Siri action text",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt zurück, wie viel Sie in einem Zeitraum ausgegeben haben, optional für eine Kategorie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns how much you've spent in a period, optionally for one category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve cuánto ha gastado en un período, opcionalmente para una categoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoie le montant que vous avez dépensé sur une période, éventuellement pour une seule catégorie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan jumlah yang Anda belanjakan dalam suatu periode, opsional untuk satu kategori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した期間の支出額を返します。1つのカテゴリに絞り込むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 기간의 지출액을 반환합니다. 카테고리를 하나 지정할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retorna quanto você gastou em um período, opcionalmente em uma categoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает сумму ваших расходов за период, при необходимости — по одной категории."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả về số tiền bạn đã chi trong một kỳ, có thể giới hạn theo một danh mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回您在某段期间内的支出金额，可选择仅计算单个类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳回您在某段期間內的支出金額，可選擇僅計算單一類別。"
          }
        }
      }
    },
    "Returns the balance of an account, or your total across all accounts.": {
      "comment": "Shortcuts / Siri action text",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt den Kontostand eines Kontos oder die Summe aller Konten zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
