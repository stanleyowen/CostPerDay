    "Tap + to record an expense, or import your history from BudgetBakers in Settings.": {
      "comment": "Transactions list",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf +, um eine Ausgabe zu erfassen, oder importieren Sie Ihren Verlauf aus BudgetBakers in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + to record an expense, or import your history from BudgetBakers in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque + para registrar un gasto o importe su historial de BudgetBakers en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour enregistrer une dépense, ou importez votre historique BudgetBakers depuis les Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk + untuk mencatat pengeluaran, atau impor riwayat Anda dari BudgetBakers di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ をタップして支出を記録するか、「設定」で BudgetBakers から履歴を読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+를 탭하여 지출을 기록하거나, 설정에서 BudgetBakers의 기록을 가져오십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em + para registrar uma despesa ou importe seu histórico do BudgetBakers em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите +, чтобы записать расход, или импортируйте историю из BudgetBakers в настройках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào + để ghi một khoản chi, hoặc nhập lịch sử từ BudgetBakers trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 记录支出，或在“设置”中从 BudgetBakers 导入您的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 記錄支出，或在「設定」中從 BudgetBakers 匯入您的記錄。"
          }
        }
      }
    },
