    "Transactions belong to an account — a bank account, a cash pocket, a card.": {
      "comment": "Transaction entry form",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchungen gehören zu einem Konto – einem Bankkonto, einer Bargeldkasse oder einer Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactions belong to an account — a bank account, a cash pocket, a card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transacciones pertenecen a una cuenta: una cuenta bancaria, efectivo, una tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transactions appartiennent à un compte : un compte bancaire, des espèces, une carte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap transaksi termasuk dalam satu akun — rekening bank, uang tunai, atau kartu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引はいずれかの口座（銀行口座、現金、カードなど）に属します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래는 은행 계좌, 현금, 카드 등 하나의 계좌에 속합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transações pertencem a uma conta: uma conta bancária, dinheiro em espécie, um cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции относятся к счёту — банковскому счёту, наличным или карте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi giao dịch thuộc về một tài khoản — tài khoản ngân hàng, tiền mặt hoặc thẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每笔交易都属于一个账户，例如银行账户、现金或卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每筆交易都屬於一個帳戶，例如銀行帳戶、現金或卡片。"
          }
        }
      }
    },
