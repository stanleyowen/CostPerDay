    "Link the purchase and any repairs or accessories to see the full cost of ownership.": {
      "comment": "Card subtitle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfen Sie den Kauf sowie etwaige Reparaturen oder Zubehör, um die gesamten Besitzkosten zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link the purchase and any repairs or accessories to see the full cost of ownership."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule la compra y cualquier reparación o accesorio para ver el costo total de propiedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liez l'achat ainsi que les réparations et accessoires éventuels pour connaître le coût total de possession."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautkan pembelian beserta perbaikan atau aksesori untuk melihat total biaya kepemilikan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入と修理・アクセサリーの取引をリンクすると、保有にかかる総コストを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 거래와 수리비, 액세서리 비용을 연결하면 총 보유 비용을 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule a compra e eventuais reparos ou acessórios para ver o custo total de posse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привяжите покупку, а также ремонт и аксессуары, чтобы увидеть полную стоимость владения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết giao dịch mua cùng các khoản sửa chữa hoặc phụ kiện để xem tổng chi phí sở hữu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联购买交易以及任何维修或配件支出，即可查看完整的持有成本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結購買交易以及任何維修或配件支出，即可查看完整的持有成本。"
          }
        }
      }
    },
