    "In BudgetBakers, open Settings → Exports and export your records as CSV.": {
      "comment": "Import from BudgetBakers Wallet screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie in BudgetBakers „Einstellungen“ → „Exporte“ und exportieren Sie Ihre Einträge als CSV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In BudgetBakers, open Settings → Exports and export your records as CSV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En BudgetBakers, abra Ajustes → Exportaciones y exporte sus registros como CSV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans BudgetBakers, ouvrez Réglages → Exports et exportez vos enregistrements au format CSV."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di BudgetBakers, buka Pengaturan → Ekspor, lalu ekspor catatan Anda sebagai CSV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers で「設定」→「エクスポート」を開き、記録を CSV として書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers에서 설정 → 내보내기를 열고 기록을 CSV로 내보내십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No BudgetBakers, abra Ajustes → Exportações e exporte seus registros como CSV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В BudgetBakers откройте «Настройки» → «Экспорт» и экспортируйте записи в формате CSV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong BudgetBakers, mở Cài đặt → Xuất và xuất dữ liệu của bạn dưới dạng CSV."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 BudgetBakers 中打开“设置”→“导出”，并将记录导出为 CSV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 BudgetBakers 中開啟「設定」→「匯出」，並將記錄匯出為 CSV。"
          }
        }
      }
    },
    "In Shortcuts, open Automation and tap +.": {
