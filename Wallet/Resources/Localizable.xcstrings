    "Opens Settings, where the language for this application can be changed independently of the system language.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Einstellungen, in denen die Sprache dieser Anwendung unabhängig von der Systemsprache geändert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Settings, where the language for this application can be changed independently of the system language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes, donde puede cambiarse el idioma de esta aplicación con independencia del idioma del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les Réglages, où la langue de cette application peut être modifiée indépendamment de celle du système."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Pengaturan, tempat bahasa aplikasi ini dapat diubah secara terpisah dari bahasa sistem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開きます。設定では、システムの言語とは別に、このアプリケーションの言語を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 엽니다. 설정에서는 시스템 언어와 별도로 이 애플리케이션의 언어를 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre os Ajustes, onde o idioma deste aplicativo pode ser alterado independentemente do idioma do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает «Настройки», где язык этого приложения можно изменить независимо от языка системы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở phần Cài đặt, nơi có thể thay đổi ngôn ngữ của ứng dụng này độc lập với ngôn ngữ hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“设置”，可在其中将本应用的语言设置为不同于系统语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「設定」，可在其中將本應用程式的語言設定為不同於系統語言。"
          }
        }
      }
    },
