    "%lld transfers have no matching account in the export, so they're kept as money moving in or out of Wallet.": {
      "comment": "Import from BudgetBakers Wallet screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Für %lld Umbuchung gibt es im Export kein passendes Konto; sie wird daher als Geldbewegung von oder nach außerhalb von Wallet übernommen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Für %lld Umbuchungen gibt es im Export kein passendes Konto; sie werden daher als Geldbewegungen von oder nach außerhalb von Wallet übernommen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transfer has no matching account in the export, so it's kept as money moving in or out of Wallet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transfers have no matching account in the export, so they're kept as money moving in or out of Wallet."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transferencia no tiene una cuenta correspondiente en la exportación, por lo que se conserva como dinero que entra en Wallet o sale de él."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transferencias no tienen una cuenta correspondiente en la exportación, por lo que se conservan como dinero que entra en Wallet o sale de él."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld virement n'a pas de compte correspondant dans l'export ; il est donc conservé comme un flux entrant ou sortant de Wallet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld virements n'ont pas de compte correspondant dans l'export ; ils sont donc conservés comme des flux entrants ou sortants de Wallet."
                }
              }
            }
          }
        },
        "id": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transfer tidak memiliki akun yang cocok dalam file ekspor, sehingga dicatat sebagai uang yang masuk ke atau keluar dari Wallet."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 件の振替は書き出しデータ内に対応する口座がないため、Wallet 外との入出金として保持されます。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "이체 %lld건은 내보낸 파일에 일치하는 계좌가 없어 Wallet 외부와 주고받은 금액으로 유지됩니다."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transferência não tem conta correspondente na exportação e, por isso, é mantida como dinheiro entrando no Wallet ou saindo dele."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transferências não têm conta correspondente na exportação e, por isso, são mantidas como dinheiro entrando no Wallet ou saindo dele."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Для %lld переводов в экспорте нет соответствующего счёта, поэтому они сохраняются как движение средств извне Wallet или за его пределы."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Для %lld переводов в экспорте нет соответствующего счёта, поэтому они сохраняются как движение средств извне Wallet или за его пределы."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Для %lld перевода в экспорте нет соответствующего счёта, поэтому он сохраняется как движение средств извне Wallet или за его пределы."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Для %lld переводов в экспорте нет соответствующего счёта, поэтому они сохраняются как движение средств извне Wallet или за его пределы."
                }
              }
            }
          }
        },
        "vi": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld giao dịch chuyển khoản không có tài khoản tương ứng trong tệp xuất, nên được giữ lại dưới dạng tiền chuyển vào hoặc ra khỏi Wallet."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
