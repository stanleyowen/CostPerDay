    "Add Wallet's Add Transaction action. Set Amount to the transaction's Amount and Merchant to its Merchant.": {
      "comment": "Shortcuts & Siri help screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie die Wallet-Aktion „Buchung hinzufügen“ hinzu. Setzen Sie „Betrag“ auf den Betrag der Transaktion und „Händler“ auf deren Händler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Wallet's Add Transaction action. Set Amount to the transaction's Amount and Merchant to its Merchant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada la acción Añadir transacción de Wallet. Asigne a Importe el Importe de la transacción y a Comercio su Comercio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l'action Ajouter une transaction de Wallet. Définissez Montant sur le Montant de la transaction et Marchand sur son Marchand."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tindakan Tambah Transaksi dari Wallet. Atur Jumlah ke Jumlah transaksi dan Merchant ke Merchant transaksi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet の「取引を追加」アクションを追加します。「金額」には取引の「金額」を、「加盟店」には取引の「加盟店」を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet의 '거래 추가' 동작을 추가합니다. '금액'은 거래의 금액으로, '가맹점'은 거래의 가맹점으로 설정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a ação Adicionar transação do Wallet. Defina Valor como o Valor da transação e Comerciante como o Comerciante dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте действие Wallet «Добавить операцию». Укажите в поле «Сумма» сумму транзакции, а в поле «Продавец» — её продавца."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tác vụ Thêm giao dịch của Wallet. Đặt Số tiền thành Số tiền của giao dịch và Người bán thành Người bán của giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Wallet 的“添加交易”操作。将“金额”设为交易的“金额”，并将“商户”设为交易的“商户”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 Wallet 的「新增交易」動作。將「金額」設為交易的「金額」，並將「商戶」設為交易的「商戶」。"
          }
        }
      }
    },
