    "Reports by category, label and account, with trends, budgets and a spending calendar.": {
      "comment": "Onboarding page body",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichte nach Kategorie, Label und Konto, mit Trends, Budgets und einem Ausgabenkalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports by category, label and account, with trends, budgets and a spending calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informes por categoría, etiqueta y cuenta, con tendencias, presupuestos y un calendario de gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rapports par catégorie, étiquette et compte, avec tendances, budgets et calendrier des dépenses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan menurut kategori, label, dan akun, dilengkapi tren, anggaran, dan kalender pengeluaran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリ、ラベル、口座別のレポートに加え、推移、予算、支出カレンダーもご覧いただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리, 라벨, 계좌별 보고서와 추이, 예산, 지출 캘린더를 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatórios por categoria, etiqueta e conta, com tendências, orçamentos e um calendário de gastos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчёты по категориям, меткам и счетам, с динамикой, бюджетами и календарём расходов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo theo danh mục, nhãn và tài khoản, cùng xu hướng, ngân sách và lịch chi tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按类别、标签和账户分析的报表，并提供趋势、预算和支出日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依類別、標籤與帳戶分析的報表，並提供趨勢、預算與支出行事曆。"
          }
        }
      }
    },
