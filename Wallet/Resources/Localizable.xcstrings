    "BudgetBakers reported amounts in %@. This rate converts them into %@ for totals; original amounts are kept.": {
      "comment": "Import from BudgetBakers Wallet screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers hat Beträge in %@ angegeben. Dieser Kurs rechnet sie für die Summen in %@ um; die ursprünglichen Beträge bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers reported amounts in %@. This rate converts them into %@ for totals; original amounts are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers registraba los importes en %@. Esta tasa los convierte a %@ para los totales; los importes originales se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers indiquait les montants en %@. Ce taux les convertit en %@ pour les totaux ; les montants d'origine sont conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers mencatat jumlah dalam %@. Kurs ini mengonversinya ke %@ untuk total; jumlah asli tetap dipertahankan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers では金額が %1$@ で記録されていました。このレートで合計用に %2$@ へ換算します。元の金額は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers의 금액은 %1$@(으)로 기록되어 있습니다. 이 환율로 합계를 %2$@(으)로 환산하며, 원래 금액은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O BudgetBakers registrava os valores em %@. Esta taxa os converte para %@ nos totais; os valores originais são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers указывал суммы в %@. Этот курс пересчитывает их в %@ для итогов; исходные суммы сохраняются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers ghi nhận số tiền bằng %@. Tỷ giá này quy đổi chúng sang %@ để tính tổng; số tiền gốc được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers 以 %@ 记录金额。此汇率会将其换算为 %@ 以计算合计；原始金额会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers 以 %@ 記錄金額。此匯率會將其換算為 %@ 以計算合計；原始金額會保留。"
          }
        }
      }
    },
