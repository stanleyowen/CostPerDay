    "Account balances and reports will update. A tracked item linked to it is kept.": {
      "comment": "Transaction detail screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontostände und Berichte werden aktualisiert. Ein damit verknüpfter erfasster Artikel bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account balances and reports will update. A tracked item linked to it is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos de las cuentas y los informes se actualizarán. Se conservará el artículo vinculado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes des comptes et les rapports seront mis à jour. L'article suivi qui y est lié est conservé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo akun dan laporan akan diperbarui. Barang terlacak yang tertaut tetap disimpan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座残高とレポートが更新されます。リンクされている記録中の項目は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌 잔액과 보고서가 업데이트됩니다. 연결된 관리 항목은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos das contas e os relatórios serão atualizados. O item acompanhado vinculado a ela será mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы счетов и отчёты будут обновлены. Связанный с ней отслеживаемый предмет сохранится."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư tài khoản và báo cáo sẽ được cập nhật. Món đồ đang theo dõi được liên kết vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户余额和报表将会更新。与其关联的追踪物品会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶餘額與報表將會更新。與其連結的追蹤物品會保留。"
          }
        }
      }
    },
