    "Import a BudgetBakers Wallet CSV export. Importing again with a newer export only adds what's new.": {
      "comment": "Settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie einen CSV-Export aus BudgetBakers Wallet. Bei einem erneuten Import mit einem neueren Export werden nur neue Einträge hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a BudgetBakers Wallet CSV export. Importing again with a newer export only adds what's new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe una exportación CSV de BudgetBakers Wallet. Si vuelve a importar con una exportación más reciente, solo se añadirá lo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un export CSV de BudgetBakers Wallet. Une nouvelle importation à partir d'un export plus récent n'ajoute que les nouveautés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor file CSV hasil ekspor BudgetBakers Wallet. Mengimpor ulang dengan ekspor yang lebih baru hanya akan menambahkan data baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers Wallet から書き出した CSV ファイルを読み込みます。新しい書き出しデータで再度読み込むと、新しい分のみが追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetBakers Wallet에서 내보낸 CSV 파일을 가져옵니다. 더 최신 파일로 다시 가져오면 새로운 내역만 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe uma exportação CSV do BudgetBakers Wallet. Importar novamente com uma exportação mais recente adiciona apenas o que for novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте экспорт CSV из BudgetBakers Wallet. При повторном импорте более нового экспорта добавляются только новые записи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tệp CSV được xuất từ BudgetBakers Wallet. Khi nhập lại bằng tệp xuất mới hơn, chỉ những dữ liệu mới được thêm vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入从 BudgetBakers Wallet 导出的 CSV 文件。日后用较新的导出文件再次导入时，只会添加新增的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入從 BudgetBakers Wallet 匯出的 CSV 檔案。日後以較新的匯出檔再次匯入時，只會新增尚未匯入的內容。"
          }
        }
      }
    },
